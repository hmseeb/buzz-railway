#!/usr/bin/env bash
# Resolve the relay owner before handing off to buzz-relay.
#
# buzz-relay warn-and-ignores an invalid RELAY_OWNER_PUBKEY and starts anyway,
# which yields a running relay nobody can administer. One-click deployers also
# rarely have a Nostr keypair to hand. So: validate strictly, or mint one.
set -euo pipefail

KEYDIR="${BUZZ_GIT_REPO_PATH:-/data/git}"
KEYFILE="$KEYDIR/.owner-key"

die() { echo "buzz-boot: $*" >&2; exit 1; }

# Railway mounts volumes owned by root, but the relay runs as uid 1000 and so
# cannot create its own data directory. Fix ownership while we still have the
# privileges to do it, then immediately drop back and re-enter this script.
# Non-recursive on purpose: only the mount point itself arrives root-owned, and
# a recursive chown would crawl the whole volume on every boot.
if [ "$(id -u)" = "0" ]; then
  mkdir -p "$KEYDIR"
  chown 1000:1000 "$KEYDIR" "$(dirname "$KEYDIR")" 2>/dev/null || true
  exec setpriv --reuid=1000 --regid=1000 --init-groups "$0" "$@"
fi

if [ -n "${RELAY_OWNER_PUBKEY:-}" ]; then
  key="${RELAY_OWNER_PUBKEY,,}"
  [[ "$key" =~ ^[0-9a-f]{64}$ ]] || die \
    "RELAY_OWNER_PUBKEY must be 64 hex characters, got '${RELAY_OWNER_PUBKEY}'. \
An npub is bech32, not hex — convert it first, or leave this blank and a keypair \
will be generated for you."
  RELAY_OWNER_PUBKEY="$key"
else
  mkdir -p "$KEYDIR" 2>/dev/null || true
  # Regenerating on every boot would silently rotate the owner and lock the
  # operator out, so an unwritable volume is fatal rather than best-effort.
  [ -w "$KEYDIR" ] || die "cannot write $KEYDIR — the owner key must persist across restarts"

  if [ ! -f "$KEYFILE" ]; then
    (umask 077; buzz-admin generate-key > "$KEYFILE")
    # buzz-admin prints hex, but the desktop and mobile apps only accept bech32
    # nsec1…, so print that form or first login is a dead end.
    gen_pub=$(awk '/^Public key:/{print $3}' "$KEYFILE")
    gen_sec=$(awk '/^Secret key:/{print $3}' "$KEYFILE")
    echo "buzz-boot: ============================================================"
    echo "buzz-boot: No RELAY_OWNER_PUBKEY was set, so an owner keypair was"
    echo "buzz-boot: generated. In the Buzz app choose 'Use an existing key'"
    echo "buzz-boot: and paste the secret key below."
    echo "buzz-boot:"
    echo "buzz-boot:   secret (sign in with this):  $(buzz-nsec nsec "$gen_sec")"
    echo "buzz-boot:   public (your identity):      $(buzz-nsec npub "$gen_pub")"
    echo "buzz-boot:"
    echo "buzz-boot: Save the secret now. It stays on the volume at $KEYFILE,"
    echo "buzz-boot: and hex copies of both are in that file."
    echo "buzz-boot: ============================================================"
  fi

  RELAY_OWNER_PUBKEY=$(awk '/^Public key:/{print $3}' "$KEYFILE")
  [[ "$RELAY_OWNER_PUBKEY" =~ ^[0-9a-f]{64}$ ]] || die \
    "could not read a hex pubkey from $KEYFILE — delete it and redeploy to regenerate"
fi

# One deploy, many workspaces: the relay resolves communities by hostname and
# can host several, but provisioning via POST /operator/communities is gated by
# RELAY_OPERATOR_PUBKEYS, and an empty allowlist disables it outright. Default
# the owner into that allowlist so a deployer can point a second hostname at the
# same stack instead of paying for a second one. An explicit list wins, since
# operators need not be the owner.
RELAY_OPERATOR_PUBKEYS="${RELAY_OPERATOR_PUBKEYS:-$RELAY_OWNER_PUBKEY}"
export RELAY_OPERATOR_PUBKEYS

# Provisioning needs the public origin too: the relay sits behind a proxy and
# cannot trust its own request URL, so without this the endpoint 500s with
# "operator API origin is not configured". Derive it from the platform domain;
# an explicit value wins.
if [ -z "${RELAY_OPERATOR_API_ORIGIN:-}" ] && [ -n "${RAILWAY_PUBLIC_DOMAIN:-}" ]; then
  RELAY_OPERATOR_API_ORIGIN="https://${RAILWAY_PUBLIC_DOMAIN}"
fi
export RELAY_OPERATOR_API_ORIGIN

# The relay refuses to start on a malformed bind address, and the usual way to
# get one is a platform variable reference that resolved to nothing, leaving
# "0.0.0.0:" with no port. Repair it from $PORT; an explicit valid value wins.
if [[ ! "${BUZZ_BIND_ADDR:-}" =~ :[0-9]+$ ]]; then
  BUZZ_BIND_ADDR="0.0.0.0:${PORT:-3000}"
fi

# The health router listens on 8080 by default. Railway injects its own $PORT
# which overrides anything set in the image, and when that value is also 8080
# the relay starts cleanly and then dies on "Address already in use" — a
# failure that reads like a networking fault rather than a port collision.
app_port="${BUZZ_BIND_ADDR##*:}"
if [ "${BUZZ_HEALTH_PORT:-8080}" = "$app_port" ]; then
  BUZZ_HEALTH_PORT=$((app_port + 1))
fi
BUZZ_HEALTH_PORT="${BUZZ_HEALTH_PORT:-8080}"

# The desktop and mobile apps run from tauri://localhost, not the public web
# address, so a relay whose allowed origins are locked to that address blocks
# every read the app makes — the request is rejected inside the app before it
# is ever sent, and the relay logs nothing. Always keep the app origins in the
# list. An empty list already means "allow any origin", so only append when the
# deployer has restricted it.
if [ -n "${BUZZ_CORS_ORIGINS:-}" ]; then
  BUZZ_CORS_ORIGINS="${BUZZ_CORS_ORIGINS},tauri://localhost,https://tauri.localhost,http://tauri.localhost"
  export BUZZ_CORS_ORIGINS
fi

export RELAY_OWNER_PUBKEY BUZZ_BIND_ADDR BUZZ_HEALTH_PORT

# Extra workspaces, the no-brainer path: a deployer lists community hostnames in
# BUZZ_EXTRA_COMMUNITY_HOSTS (comma-separated) and points those domains at this
# service. On every boot we create any that don't exist yet — idempotent, so
# re-listing an existing one is a no-op. This needs the owner's secret to sign
# the request, which we only have when the key was generated here; if the
# deployer supplied their own pubkey instead, we log and skip.
if [ -n "${BUZZ_EXTRA_COMMUNITY_HOSTS:-}" ]; then
  if [ -f "$KEYFILE" ]; then
    owner_secret=$(awk '/^Secret key:/{print $3}' "$KEYFILE")
    app_port="${BUZZ_BIND_ADDR##*:}"
    health_port="$BUZZ_HEALTH_PORT"
    origin="${RELAY_OPERATOR_API_ORIGIN:-}"
    owner_pub="$RELAY_OWNER_PUBKEY"
    hosts="$BUZZ_EXTRA_COMMUNITY_HOSTS"
    # Detached child: waits for the relay to be ready, then creates each host.
    # It survives the exec below because it is already a separate process.
    (
      for _ in $(seq 1 60); do
        if curl -fsS "http://127.0.0.1:${health_port}/_readiness" >/dev/null 2>&1; then
          break
        fi
        sleep 2
      done
      OLD_IFS="$IFS"; IFS=','
      for host in $hosts; do
        IFS="$OLD_IFS"
        host=$(echo "$host" | tr -d '[:space:]')
        [ -z "$host" ] && continue
        buzz-provision "$owner_secret" "$origin" "$host" "$owner_pub" "$app_port" \
          || echo "buzz-boot: could not create workspace '$host' (will retry next boot)"
        IFS=','
      done
      IFS="$OLD_IFS"
    ) &
  else
    echo "buzz-boot: BUZZ_EXTRA_COMMUNITY_HOSTS is set but the owner key was" >&2
    echo "buzz-boot: supplied, not generated, so there is no secret here to" >&2
    echo "buzz-boot: create them with. Create extra workspaces from your own app." >&2
  fi
fi

exec "$@"
