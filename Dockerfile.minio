# MinIO with its server command and bucket creation baked in, so the Railway
# template needs no startCommand and no separate init service.
# Upstream minio/minio was pulled from Docker Hub; pgsty/minio was a maintained
# drop-in fork, renamed pgsty/silo on 2026-08-06 (pgsty/minio stopped at
# RELEASE.2026-08-04). Same protocol and data format; binary is silo, ships mc.
FROM pgsty/silo:RELEASE.2026-11-12T00-00-00Z@sha256:c20d112390b9a9ce8c11b8af95ad35bcaa62f4759663c09c936cd8d2b511f329

LABEL org.opencontainers.image.title="MinIO for Buzz on Railway" \
      org.opencontainers.image.version="RELEASE.2026-11-12T00-00-00Z-r1" \
      org.opencontainers.image.description="MinIO that starts unattended and creates the Buzz media bucket" \
      org.opencontainers.image.source="https://github.com/hmseeb/buzz-railway"

# Same reasoning as the relay image: only the password varies per deploy, so
# everything else is baked in and never reaches the template.
# PORT is a local-run fallback only. Railway injects its own PORT at runtime,
# which overrides anything set here, so the template must pin PORT=9000
# explicitly — the relay addresses this service at a fixed port.
ENV PORT=9000 \
    MINIO_ROOT_USER=buzz \
    MINIO_BROWSER=off \
    BUZZ_S3_BUCKET=buzz-media

COPY --chmod=0755 minio-boot /usr/local/bin/minio-boot

# The base image sets CMD, which would otherwise arrive as stray arguments.
ENTRYPOINT ["/usr/local/bin/minio-boot"]
CMD []
