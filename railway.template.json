{
  "$schema": "https://railway.com/railway.schema.json",
  "name": "Buzz",
  "description": "Self-host Buzz, Block's hive-mind workspace for humans and AI agents. Includes the relay with bundled web UI, Postgres, Redis, and S3-compatible media storage.",
  "services": {
    "buzz": {
      "name": "Buzz",
      "source": {
        "image": "ghcr.io/hmseeb/buzz-railway:latest"
      },
      "deploy": {
        "healthcheckPath": "/_readiness",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "networking": {
        "serviceDomains": {
          "buzz": {}
        }
      },
      "variables": {
        "BUZZ_RELAY_PRIVATE_KEY": "${{secret(64, 'abcdef0123456789')}}",
        "BUZZ_GIT_HOOK_HMAC_SECRET": "${{secret(64, 'abcdef0123456789')}}",
        "BUZZ_CORS_ORIGINS": "https://${{RAILWAY_PUBLIC_DOMAIN}}",
        "BUZZ_MEDIA_BASE_URL": "https://${{RAILWAY_PUBLIC_DOMAIN}}/media",
        "RELAY_URL": "wss://${{RAILWAY_PUBLIC_DOMAIN}}",
        "BUZZ_S3_ENDPOINT": "http://${{MinIO.RAILWAY_PRIVATE_DOMAIN}}:9000",
        "BUZZ_S3_SECRET_KEY": "${{MinIO.MINIO_ROOT_PASSWORD}}",
        "DATABASE_URL": "${{Postgres.DATABASE_URL}}",
        "REDIS_URL": "${{Redis.REDIS_URL}}",
        "RELAY_OWNER_PUBKEY": {
          "description": "Optional. Your Nostr public key as 64 hex characters (not an npub). Leave blank and an owner keypair is generated on first boot — the secret key is printed once in this service's deploy logs.",
          "isOptional": true
        }
      },
      "volumeMounts": [
        {
          "mountPath": "/data",
          "volumeName": "buzz-data"
        }
      ]
    },
    "postgres": {
      "name": "Postgres",
      "source": {
        "image": "ghcr.io/railwayapp-templates/postgres-ssl:17"
      },
      "deploy": {
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "variables": {
        "PGDATA": "/var/lib/postgresql/data",
        "POSTGRES_DB": "buzz",
        "POSTGRES_PASSWORD": "${{secret(32)}}",
        "POSTGRES_USER": "buzz"
      },
      "volumeMounts": [
        {
          "mountPath": "/var/lib/postgresql/data",
          "volumeName": "postgres-data",
          "backupSchedules": [
            "DAILY"
          ]
        }
      ]
    },
    "redis": {
      "name": "Redis",
      "source": {
        "image": "redis:8-alpine"
      },
      "deploy": {
        "startCommand": "/bin/sh -c \"rm -rf $RAILWAY_VOLUME_MOUNT_PATH/lost+found && exec redis-server --requirepass $REDIS_PASSWORD --appendonly yes --dir $RAILWAY_VOLUME_MOUNT_PATH\"",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "variables": {
        "REDIS_PASSWORD": "${{secret(32)}}",
        "REDIS_URL": "redis://:${{REDIS_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:6379"
      },
      "volumeMounts": [
        {
          "mountPath": "/data",
          "volumeName": "redis-data"
        }
      ]
    },
    "minio": {
      "name": "MinIO",
      "source": {
        "image": "ghcr.io/hmseeb/buzz-railway-minio:latest"
      },
      "deploy": {
        "healthcheckPath": "/minio/health/live",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "variables": {
        "MINIO_ROOT_PASSWORD": "${{secret(32)}}",
        "MINIO_DOMAIN": "${{RAILWAY_PRIVATE_DOMAIN}}"
      },
      "volumeMounts": [
        {
          "mountPath": "/data",
          "volumeName": "minio-data"
        }
      ]
    }
  },
  "canvasConfig": {
    "services": {
      "buzz": { "x": 0, "y": 0 },
      "postgres": { "x": -280, "y": 180 },
      "redis": { "x": 0, "y": 180 },
      "minio": { "x": 280, "y": 180 }
    }
  }
}
